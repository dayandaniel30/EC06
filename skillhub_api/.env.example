# =============================================================================
# Laravel - configuration locale (execution HORS Docker)
# =============================================================================
# Pour la stack Docker complete, c'est le fichier `.env.example` a la RACINE du
# depot qui fait foi : il couvre Laravel, Spring Boot et Docker en une seule
# source. Ce fichier-ci sert au developpement direct (`php artisan serve`) et a
# l'integration continue.
#
#     cp .env.example .env && php artisan key:generate
# =============================================================================

APP_NAME=Skillhub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale par defaut de l'application. `lang/fr` est disponible : passer
# APP_LOCALE=fr bascule les messages de validation en francais (les tests
# existants attendent les messages anglais par defaut).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees -------------------------------------------------------
# Hors Docker, la base ecoute sur le port publie par compose (3307 par defaut).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=skillhubsql
DB_USERNAME=root
DB_PASSWORD=root

# --- Sessions, cache, files ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Microservice SSO ------------------------------------------------------
# Hors Docker, le SSO est joint via le port publie sur l'hote.
# Dans la stack Docker, cette valeur devient http://spring-sso:8080.
SSO_BASE_URL=http://localhost:8080
SSO_JWT_ISSUER=skillhub-sso
SSO_JWT_AUDIENCE=skillhub-laravel
SSO_HTTP_TIMEOUT=5

# --- Regles metier ---------------------------------------------------------
# Q1 : seuil de desactivation des comptes inactifs (180 jours = 6 mois).
USER_INACTIVITY_DAYS=180
USER_INACTIVITY_CHUNK=200
LEARNER_MAX_ACTIVE_ENROLLMENTS=5
