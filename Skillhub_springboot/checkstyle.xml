<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Regles Checkstyle du microservice SSO Skillhub.

  Le jeu de regles est volontairement cible sur ce qui revele de vrais defauts
  (imports inutilises, blocs vides, accolades manquantes, egalite de chaines par
  reference) plutot que sur la mise en forme pure, deja garantie par l'IDE et la
  revue. Objectif : une etape Lint qui echoue seulement quand c'est justifie.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Un fichier source qui depasse 800 lignes doit etre decoupe. -->
    <module name="FileLength">
        <property name="max" value="800"/>
    </module>

    <!-- Les tabulations melangees aux espaces cassent l'alignement en revue. -->
    <module name="FileTabCharacter"/>

    <!-- Pas d'espaces en fin de ligne : bruit de diff garanti sinon. -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Espaces en fin de ligne."/>
    </module>

    <!-- Depuis Checkstyle 8.24, LineLength se declare au niveau Checker. -->
    <module name="LineLength">
        <property name="max" value="140"/>
        <property name="ignorePattern" value="^package.*|^import.*|^\s*\*.*https?://"/>
    </module>

    <module name="TreeWalker">

        <!-- ===== Imports ===== -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- ===== Conventions de nommage ===== -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <!-- `log` est la convention SLF4J (et celle generee par Lombok @Slf4j) :
             on l'autorise a cote du SCREAMING_SNAKE_CASE habituel. -->
        <module name="ConstantName">
            <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="MemberName"/>

        <!-- ===== Structure du code ===== -->
        <!-- Un if/for/while sans accolades est une source classique de bugs. -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- ===== Pieges courants ===== -->
        <!-- Comparer des chaines avec == compare des references, pas des valeurs. -->
        <module name="StringLiteralEquality"/>
        <!-- equals() sans hashCode() casse le comportement dans les collections. -->
        <module name="EqualsHashCode"/>
        <!-- Un parametre reaffecte masque l'intention de l'appelant. -->
        <module name="ParameterAssignment"/>
        <!-- Les champs publics non finaux exposent l'etat interne. -->
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
        </module>

        <!-- ===== Complexite ===== -->
        <module name="MethodLength">
            <property name="max" value="120"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="12"/>
        </module>

        <!-- ===== Lisibilite ===== -->
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
    </module>
</module>
