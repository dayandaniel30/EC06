# =============================================================================
# Skillhub - configuration unifiee (Laravel + Spring Boot + Docker)
# =============================================================================
# Copier ce fichier en `.env` a la racine du depot avant `docker compose up` :
#
#     cp .env.example .env
#
# Docker Compose lit automatiquement ce `.env` et injecte les valeurs dans les
# conteneurs. Le fichier `.env` reel est ignore par Git (voir .gitignore) et ne
# doit JAMAIS etre commite.
#
# -----------------------------------------------------------------------------
# AVERTISSEMENT
# -----------------------------------------------------------------------------
# Les cles ci-dessous sont des valeurs de DEVELOPPEMENT, publiques et connues.
# Elles permettent de lancer la stack en local immediatement. En production,
# regenerez-les et fournissez-les par le gestionnaire de secrets de votre
# orchestrateur (GitHub Actions, Kubernetes Secrets, Vault, ...).
# =============================================================================


# =============================================================================
# 1. Application Laravel (microservice metier)
# =============================================================================
APP_NAME=Skillhub
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Cle de chiffrement Laravel. Regenerer avec :
#     docker compose run --rm skillhub-laravel php artisan key:generate --show
APP_KEY=base64:ez8W3CixZjpozlCIQHE/+NvyURRJNkKeZ6Yv3WZJroY=

# `stderr` envoie les logs vers la sortie du conteneur, lisible via
# `docker compose logs`. Utiliser `stack` pour ecrire dans storage/logs.
LOG_CHANNEL=stderr

# Port publie sur la machine hote.
LARAVEL_PORT=8000


# =============================================================================
# 2. Base de donnees metier (MySQL)
# =============================================================================
# Base dediee au domaine metier : formations, inscriptions, notes, utilisateurs
# locaux. Le SSO n'y a aucun acces (pattern Database per Service).
# -----------------------------------------------------------------------------
LARAVEL_DB_DATABASE=skillhubsql
LARAVEL_DB_USERNAME=root
LARAVEL_DB_PASSWORD=root

# Port hote. 3307 evite le conflit avec un MySQL/MariaDB deja installe.
LARAVEL_DB_PORT=3307


# =============================================================================
# 3. Microservice SSO (Spring Boot)
# =============================================================================
# Port publie sur la machine hote. En interne, Laravel joint toujours le SSO
# via http://spring-sso:8080 sur le reseau Docker prive.
SSO_PORT=8080

# Secret HMAC de signature des JWT, encode en Base64 (32 octets minimum).
# Regenerer avec :
#     openssl rand -base64 48
SA_JWT_SECRET=Y2hhbmdlLW1lLXNraWxsaHViLXNzby1tYXN0ZXIta2V5LTIwMjYtMzJieXRlcy1taW4=

# Claims verifiees des deux cotes : un jeton emis pour une autre audience ou par
# un autre emetteur est rejete.
SSO_JWT_ISSUER=skillhub-sso
SSO_JWT_AUDIENCE=skillhub-laravel
SSO_JWT_EXPIRATION_SECONDS=3600

# Delai maximum des appels HTTP Laravel -> SSO, en secondes.
SSO_HTTP_TIMEOUT=5

# Reglage memoire de la JVM dans le conteneur.
SSO_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# --- Compte de demonstration cree au premier demarrage ---
# A supprimer ou desactiver en production.
SSO_SEED_USERNAME=apprenant@skillhub.test
SSO_SEED_PASSWORD=Skillhub123!
SSO_SEED_ROLE=APPRENANT


# =============================================================================
# 4. Base de donnees du SSO (PostgreSQL)
# =============================================================================
# Base dediee aux identifiants. Contient les hash BCrypt des mots de passe et
# les tokens de reinitialisation, rien d'autre.
# -----------------------------------------------------------------------------
SSO_DB_DATABASE=sso_db
SSO_DB_USERNAME=sso
SSO_DB_PASSWORD=sso

# Port hote. 5433 par defaut : 5432 est presque toujours pris par un PostgreSQL
# installe nativement sur la machine.
SSO_DB_PORT=5433


# =============================================================================
# 5. Regles metier
# =============================================================================
# Q1 - Seuil d'inactivite (en jours) au-dela duquel `users:purge-inactive`
# revoque les acces et desactive le compte. 180 jours = 6 mois.
USER_INACTIVITY_DAYS=180

# Nombre de comptes traites par lot pendant la purge.
USER_INACTIVITY_CHUNK=200

# Nombre maximum de formations suivies simultanement par un apprenant.
LEARNER_MAX_ACTIVE_ENROLLMENTS=5


# =============================================================================
# 6. Registry Docker (build local et CI/CD)
# =============================================================================
# En CI, ces valeurs viennent des secrets GitHub (REGISTRY_USER / REGISTRY_TOKEN)
# et ne sont jamais ecrites dans un fichier. Ici, elles servent uniquement a
# nommer les images construites en local.
# -----------------------------------------------------------------------------
REGISTRY_URL=docker.io
REGISTRY_NAMESPACE=skillhub
IMAGE_TAG=latest


# =============================================================================
# 7. Rappel : secrets a configurer dans GitHub Actions
# =============================================================================
# Ces valeurs ne figurent PAS dans ce fichier et ne doivent jamais y figurer.
# Les declarer dans Settings > Secrets and variables > Actions :
#
#   Secrets   SONAR_TOKEN      jeton d'analyse SonarCloud
#             REGISTRY_USER    identifiant de la registry Docker
#             REGISTRY_TOKEN   jeton d'acces de la registry Docker
#
#   Variables SONAR_ORG          organisation SonarCloud
#             SONAR_PROJECT_KEY  cle du projet SonarCloud
#             REGISTRY_URL       hote de la registry (defaut : docker.io)
# =============================================================================
