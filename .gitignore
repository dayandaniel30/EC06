# Environnement Docker Compose (racine)
# Ce fichier contient les secrets injectes dans les conteneurs : il ne doit
# jamais etre commite. Seul .env.example est versionne.
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/

# Laravel
skillhub_api/vendor/
skillhub_api/node_modules/
skillhub_api/.env
skillhub_api/.env.*
!skillhub_api/.env.example
skillhub_api/storage/logs/*
!skillhub_api/storage/logs/.gitkeep
skillhub_api/storage/framework/cache/data/*
skillhub_api/storage/framework/sessions/*
skillhub_api/storage/framework/views/*
skillhub_api/bootstrap/cache/*.php
skillhub_api/public/storage
skillhub_api/public/hot
skillhub_api/coverage.xml
skillhub_api/phpunit.junit.xml
skillhub_api/.phpunit.result.cache
skillhub_api/.phpunit.cache/
skillhub_api/.phpstan.cache/

# Spring Boot / Maven
Skillhub_springboot/target/*
!Skillhub_springboot/target/site/
Skillhub_springboot/target/site/*
!Skillhub_springboot/target/site/apidocs/
Skillhub_springboot/.mvn/
!Skillhub_springboot/.mvn/wrapper/maven-wrapper.properties
Skillhub_springboot/HELP.md

# Logs & temp
*.log
*.tmp
*.bak

# Dashboard React
Tableau de bord - Formateur/node_modules/
Tableau de bord - Formateur/build/

# Misc
*.zip
